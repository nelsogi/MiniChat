<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MiniChat</RootNamespace>
    <!-- DataBuilder est un projet à part : ses fichiers ne font pas partie de MiniChat. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);DataBuilder/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version CUDA : utilise le GPU NVIDIA s'il y en a un (pilote récent requis), sinon le CPU.
         Le choix se fait tout seul au démarrage, voir cuda.is_available() dans Program.cs. -->
    <PackageReference Include="TorchSharp-cuda-windows" Version="0.105.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copie les données d'entraînement à côté de l'exécutable. -->
    <None Update="data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
